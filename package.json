{
  "name": "temp-mail",
  "version": "1.0.0",
  "description": "Disposable temp-mail web app: generate throwaway addresses on demand and receive replies sent to them.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "keywords": [
    "temp-mail",
    "disposable-email",
    "smtp",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
