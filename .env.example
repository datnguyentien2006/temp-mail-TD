# ------------------------------------------------------------------
# Temp Mail configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Comma-separated list of domains the server will accept mail for.
# Every domain here MUST have an MX record pointing at this server.
DOMAINS=example.com,example.net

# HTTP server
HOST=0.0.0.0
PORT=3000

# Inbound SMTP server
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
# Max accepted message size in bytes (10 MB)
SMTP_MAX_MESSAGE_BYTES=10485760
# Optional TLS for inbound SMTP (STARTTLS). Provide BOTH to enable.
# SMTP_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# SMTP_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem

# Mailbox lifetime in minutes (cleanup job removes expired mailboxes)
MAILBOX_TTL_MINUTES=30

# Hard ceiling on a mailbox's total life, however often it is extended.
# Defaults to 4x MAILBOX_TTL_MINUTES.
MAX_MAILBOX_LIFETIME_MINUTES=120

# Max simultaneous mailboxes per browser session
MAX_MAILBOXES_PER_SESSION=5

# Cleanup job interval in milliseconds
SWEEP_INTERVAL_MS=60000

# Client polling interval (ms) used when the WebSocket is unavailable
POLL_INTERVAL_MS=8000

# Rate limiting for mailbox creation (per IP)
CREATE_RATE_LIMIT_WINDOW_MS=600000
CREATE_RATE_LIMIT_MAX=30

# CORS origin for the API. Use `*` only if you really need cross-origin,
# otherwise leave as the site origin or empty for same-origin only.
CORS_ORIGIN=

# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# Length of auto-generated random local parts
RANDOM_LOCAL_PART_LENGTH=10

# ------------------------------------------------------------------
# Second provider: Guerrilla Mail (public JSON API, no API key)
# ------------------------------------------------------------------
# Set to false to disable it entirely (it disappears from /api/domains
# and the UI picker).
ENABLE_GUERRILLA=true

# Background polling for *open* Guerrilla inboxes. The server clamps this
# to at least 10000 ms because Guerrilla asks clients to be conservative.
GUERRILLA_POLL_INTERVAL_MS=15000

# Never sync the same inbox more often than this (milliseconds).
GUERRILLA_MIN_SYNC_INTERVAL_MS=15000

# Per-request timeout (milliseconds).
GUERRILLA_REQUEST_TIMEOUT_MS=10000

# Global limits: concurrent calls and minimum spacing between calls.
GUERRILLA_MAX_CONCURRENCY=4
GUERRILLA_MIN_REQUEST_INTERVAL_MS=300

# Exponential backoff ceiling after errors / 429 / 5xx (milliseconds).
GUERRILLA_MAX_BACKOFF_MS=300000

# How long an inbox counts as "open" after it is used (milliseconds).
GUERRILLA_ACTIVE_WINDOW_MS=300000

# Local lifetime for Guerrilla inboxes (they keep mail for ~60 minutes).
GUERRILLA_RETENTION_MINUTES=60

# Override only for testing or when proxying the API.
# GUERRILLA_API_BASE=https://api.guerrillamail.com/ajax.php
# GUERRILLA_USER_AGENT=temp-mail-td/1.0 (self-hosted disposable mail)

# ------------------------------------------------------------------
# Third provider: Resend inbound (RECEIVE-ONLY)
# ------------------------------------------------------------------
# This provider only RECEIVES mail. It never sends, replies or forwards.
# Requires an API key with FULL ACCESS (a "sending access" key cannot read
# received mail) and a receiving webhook pointing at
# https://<your-public-host>/api/webhooks/resend
#
# Set to false to disable it entirely (it disappears from /api/domains and
# the UI picker).
ENABLE_RESEND=true

# Domains verified for receiving in Resend, comma-separated. These are either
# custom domains you added (with Resend's MX record) or your account's
# <id>.resend.app subdomain. Mail sent to ANY username at these domains is
# received. Leave empty to disable the provider even when ENABLE_RESEND=true.
RESEND_DOMAINS=

# Secrets. NEVER commit real values. `.env` is git-ignored.
# Full-access API key (Dashboard > API keys).
RESEND_API_KEY=
# Signing secret of the receiving webhook (Dashboard > Webhooks > your endpoint).
RESEND_WEBHOOK_SECRET=

# Per-request timeout for calls to the Resend receiving API (milliseconds).
RESEND_REQUEST_TIMEOUT_MS=10000

# Retries (with exponential backoff) on 429/5xx/network errors.
RESEND_MAX_RETRIES=2
RESEND_RETRY_BASE_MS=500

# Reject webhooks whose svix-timestamp is older than this (replay protection).
# Set to 0 to disable the check.
RESEND_SIGNATURE_TOLERANCE_MS=300000

# Webhook body size cap in bytes (payloads are metadata only).
RESEND_WEBHOOK_MAX_BYTES=1048576

# How long a processed webhook id is remembered so retries are not re-imported.
RESEND_DEDUPE_TTL_MS=86400000

# Quota protection (Resend's Free plan is 100/day and 3,000/month, shared with
# sent mail, and every received message counts). Processing stops at the hard
# limit and the provider is marked unavailable in the UI; a soft ratio warns
# earlier.
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000
RESEND_SOFT_LIMIT_RATIO=0.8

# Per-mailbox / per-sender caps within a single mailbox.
RESEND_MAX_MESSAGES_PER_MAILBOX=50
RESEND_MAX_MESSAGES_PER_SENDER=20

# Override only for testing or when proxying the API.
# RESEND_API_BASE=https://api.resend.com
# RESEND_USER_AGENT=temp-mail-td/1.0 (self-hosted disposable mail)
