# ------------------------------------------------------------------
# Temp Mail configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Comma-separated list of domains the server will accept mail for.
# Every domain here MUST have an MX record pointing at this server.
DOMAINS=example.com,example.net

# HTTP server
HOST=0.0.0.0
PORT=3000

# Inbound SMTP server
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
# Max accepted message size in bytes (10 MB)
SMTP_MAX_MESSAGE_BYTES=10485760
# Optional TLS for inbound SMTP (STARTTLS). Provide BOTH to enable.
# SMTP_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# SMTP_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem

# Mailbox lifetime in minutes (cleanup job removes expired mailboxes)
MAILBOX_TTL_MINUTES=30

# Max simultaneous mailboxes per browser session
MAX_MAILBOXES_PER_SESSION=10

# Cleanup job interval in milliseconds
SWEEP_INTERVAL_MS=60000

# Rate limiting for mailbox creation (per IP)
CREATE_RATE_LIMIT_WINDOW_MS=600000
CREATE_RATE_LIMIT_MAX=30

# CORS origin for the API. Use `*` only if you really need cross-origin,
# otherwise leave as the site origin or empty for same-origin only.
CORS_ORIGIN=

# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# Length of auto-generated random local parts
RANDOM_LOCAL_PART_LENGTH=10
